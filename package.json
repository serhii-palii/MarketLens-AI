{
  "name": "marketlens-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed competitor and market intelligence.",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "postinstall": "npm run types -w api",
    "predev:api": "node -e \"require('node:fs').mkdirSync('web/dist',{recursive:true})\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test -w api",
    "build": "npm run build -w web",
    "deploy": "npm run build && npm run deploy -w api"
  }
}
