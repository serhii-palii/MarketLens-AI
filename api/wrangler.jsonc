{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "marketlens-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Built frontend, served by the same Worker as the API.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Only API paths invoke the Worker script; everything else is served as a static asset.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB_PRIVATE",
      "database_name": "marketlens-private",
      // Placeholder ID; replaced with the real ID from `wrangler d1 create` before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
    {
      "binding": "DB_DEMO",
      "database_name": "marketlens-demo",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
}
