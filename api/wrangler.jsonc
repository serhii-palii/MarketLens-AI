// FILE: api/wrangler.jsonc
// Worker configuration: entry point, static assets, database bindings, and request logging.

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "marketlens-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // Built frontend, served by the same Worker as the API.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Only API paths invoke the Worker script; everything else is served as a static asset.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB_PRIVATE",
      "database_name": "marketlens-private",
      "database_id": "132443b2-f7a2-4fd1-988c-95a867193e9c",
    },
    {
      "binding": "DB_DEMO",
      "database_name": "marketlens-demo",
      "database_id": "6b72e250-51d0-47b1-a082-ae162d1421c8",
    },
  ],
}
