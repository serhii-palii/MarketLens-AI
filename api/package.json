{
  "name": "marketlens-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:fixtures": "node spikes/make-fixtures.mjs",
    "spike:dev": "wrangler dev -c wrangler.cpu-spike.jsonc --port 8790",
    "spike:deploy": "wrangler deploy -c wrangler.cpu-spike.jsonc",
    "spike:ladder": "node spikes/run-ladder.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
