{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "marketlens-cpu-spike",
  "main": "spikes/cpu-spike.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./spikes/fixtures",
    "binding": "ASSETS",
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
